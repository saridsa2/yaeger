# yaeger-pi service configuration.
# Copy to .env next to the service and fill in. Never commit the result.

# Where the SQLite database lives. Postgres also works: postgresql+psycopg://...
YAEGERPI_DATABASE_URL=sqlite:////opt/yaeger-pi/yaegerpi.db

# Fallback cap on tier-3 generations per user per day (an invite can override it).
YAEGERPI_DAILY_GENERATION_LIMIT=20

# Shared secret for /v1/admin/*. Unset disables the admin API entirely.
YAEGERPI_ADMIN_TOKEN=

# --- Supabase (identity) -----------------------------------------------------
# The service verifies user JWTs and mints sessions through the admin API.
YAEGER_SUPABASE_URL=https://supabase.example.com
YAEGER_SUPABASE_ANON_KEY=
YAEGER_SUPABASE_SERVICE_ROLE_KEY=
# ES256 installs use the JWKS; older HS256 installs use the shared secret.
YAEGER_SUPABASE_JWT_JWKS=
YAEGER_SUPABASE_JWT_SECRET=

# --- SMTP (sign-in codes) ----------------------------------------------------
YAEGER_SMTP_HOST=smtp.example.com
YAEGER_SMTP_PORT=465
YAEGER_SMTP_USER=hello@example.com
YAEGER_SMTP_FROM="Example <hello@example.com>"
# Fernet-encrypted password; the key file is read from YAEGER_SECRET_KEY_PATH.
YAEGER_SMTP_PASSWORD_ENC=
YAEGER_SECRET_KEY_PATH=/etc/yaeger-secret.key
